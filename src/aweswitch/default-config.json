        "env": {
          "ANTHROPIC_BASE_URL": "https://glm-provider.example.com/api/anthropic",
          "ANTHROPIC_AUTH_TOKEN": "${ANTHROPIC_AUTH_TOKEN}",
          "ANTHROPIC_MODEL": "glm-5.1"
        }
      },
      "cc-gemini": {
        "env": {
          "ANTHROPIC_BASE_URL": "https://gemini-provider.example.com/anthropic",
